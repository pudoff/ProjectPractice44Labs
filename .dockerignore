# Контекст сборки Docker: только код, без данных, окружения и результатов
.git
.gitattributes
.venv
venv
**/__pycache__
**/*.pyc
**/*.pkl
dataset
task
docs
.vscode
.idea

# Include only the required image-processing pipeline
runs/*
!runs/klapan_png2dxf/
runs/klapan_png2dxf/*
!runs/klapan_png2dxf/pipeline_b/
!runs/klapan_png2dxf/pipeline_b/**

# Exclude local runtime assets
.env
.env.*
offline/
storage/
logs/
models/*
!models/SOURCES.json
result*.dxf
.local-backups/
