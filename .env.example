# Copy to .env, replace all REPLACE_ME placeholders. Never commit .env.
POSTGRES_DB=practice44
POSTGRES_USER=practice44
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_LOCAL_PASSWORD
API_PORT=8000
API_BIND_HOST=127.0.0.1
APP_IMAGE=practice44-backend:0.2.0
POSTGRES_IMAGE=postgres:16.6-bookworm
WORKER_POLL_SECONDS=2
MAX_UPLOAD_BYTES=26214400
MAX_IMAGE_PIXELS=50000000
# OCR_ADAPTER=your_module:your_function (empty until OCR is delivered)
# MODEL_DIR=/absolute/path/models  (local runs only; Compose uses /models)
# STORAGE_ROOT=/absolute/path/storage (main backend; Compose uses /storage)
# DATA_DIR=/absolute/path/storage (legacy prototype only)
APP_UID=1000
APP_GID=1000
